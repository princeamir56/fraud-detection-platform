# =============================================================================
# Local stack configuration — consumed by docker-compose.yml.
#
#   cp .env.example .env            # macOS / Linux / Git Bash
#   Copy-Item .env.example .env     # Windows PowerShell
#
# THIS FILE IS OPTIONAL. Every variable below also has a `${VAR:-default}`
# fallback inside docker-compose.yml, so the stack runs straight from a fresh
# clone with no .env at all. Create one only to change a value.
#
# NOTE: the values below are DEV-ONLY defaults. Never commit real secrets, and
# never reuse these in a shared or production environment (see docs/security.md).
# Image tags are the single source of truth for the local stack; keep them in
# sync with docs/technology-versions.md and re-check via scripts/check-versions.sh.
# =============================================================================

# --- Platform image tag (applied to all nine service images) ---
PLATFORM_VERSION=1.0.0

# --- Secrets (DEV ONLY — override everywhere else) ---
# JWT signing key: HMAC-SHA256 requires >= 32 bytes or services fail fast on boot.
JWT_SECRET=dev-only-insecure-secret-change-me-32bytes-minimum
JWT_ISSUER=fraud-detection-platform

# customer-service bootstrap admin (used to mint the first ADMIN token).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-change-me

# --- MySQL credentials ---
MYSQL_ROOT_PASSWORD=root
MYSQL_APP_USER=fraud
MYSQL_APP_PASSWORD=fraud

# --- Infrastructure image versions (see docs/technology-versions.md) ---
MYSQL_VERSION=8.4
CASSANDRA_VERSION=5.0
CONFLUENT_VERSION=8.0.0
ELASTIC_VERSION=9.0.4
KAFKA_UI_VERSION=v0.7.2
JAEGER_VERSION=1.62.0
OTELCOL_VERSION=0.111.0

# =============================================================================
# Host-side port mappings — uncomment and change any that clash with something
# already running on this machine (a local MySQL on 3306, Tomcat on 8080, an
# Elasticsearch on 9200 ...). `scripts/up.sh` reports the exact variable to set
# when it detects a conflict.
#
# These change ONLY the port published on the host. Services address each other
# by container hostname on fixed ports (mysql:3306, kafka:9092,
# schema-registry:8081, otel-collector:4318), so in-network wiring is unaffected.
# =============================================================================

# --- Infrastructure ---
#MYSQL_PORT=3306
#CASSANDRA_PORT=9042
#KAFKA_INTERNAL_PORT=9092         # in-network listener, rarely needed on the host
#KAFKA_HOST_PORT=29092            # host bootstrap server (also re-advertised to clients)
#SCHEMA_REGISTRY_PORT=8090        # container listens on 8081
#ES_PORT=9200
#OTLP_HTTP_PORT=4318
#OTLP_GRPC_PORT=4317
#JAEGER_UI_PORT=16686

# --- Optional consoles (`--profile consoles`) ---
#KIBANA_PORT=5601
#KAFKA_UI_PORT=8100

# --- Application services ---
#GATEWAY_PORT=8080                # the only port a client actually needs
#CUSTOMER_PORT=8081
#ACCOUNT_PORT=8082
#TRANSACTION_PORT=8083
#FRAUD_PORT=8084
#RISK_HTTP_PORT=8085
#RISK_GRPC_PORT=9095
#ALERT_PORT=8086
#NOTIFICATION_PORT=8087
#AUDIT_PORT=8088

# =============================================================================
# Memory tuning — raise these only if Docker has RAM to spare. The defaults are
# sized so the lean stack fits in an 8 GB Docker allocation.
# =============================================================================

#ES_HEAP=512m
#CASSANDRA_HEAP=512M
#CASSANDRA_NEWSIZE=128M

# Locking the Elasticsearch heap into RAM requires a memlock rlimit that not
# every host grants; when it is refused ES exits at boot. Left false for
# portability — set true only on a host you know allows it.
#ES_MEMORY_LOCK=false
