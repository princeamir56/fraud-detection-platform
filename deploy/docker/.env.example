# =============================================================================
# Local stack configuration — consumed by docker-compose.yml.
#
#   cp .env.example .env   # then edit secrets for anything beyond local dev
#
# NOTE: the values below are DEV-ONLY defaults. Never commit real secrets, and
# never reuse these in a shared or production environment (see docs/security.md).
# Image tags are the single source of truth for the local stack; keep them in
# sync with docs/technology-versions.md and re-check via scripts/check-versions.sh.
# =============================================================================

# --- Platform image tag (applied to all nine service images) ---
PLATFORM_VERSION=1.0.0

# --- Secrets (DEV ONLY — override everywhere else) ---
# JWT signing key: HMAC-SHA256 requires >= 32 bytes or services fail fast on boot.
JWT_SECRET=dev-only-insecure-secret-change-me-32bytes-minimum
JWT_ISSUER=fraud-detection-platform

# customer-service bootstrap admin (used to mint the first ADMIN token).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin-change-me

# --- MySQL credentials ---
MYSQL_ROOT_PASSWORD=root
MYSQL_APP_USER=fraud
MYSQL_APP_PASSWORD=fraud

# --- Infrastructure image versions (see docs/technology-versions.md) ---
MYSQL_VERSION=8.4
CASSANDRA_VERSION=5.0
CONFLUENT_VERSION=8.0.0
ELASTIC_VERSION=9.0.4
KAFKA_UI_VERSION=v0.7.2
JAEGER_VERSION=1.62.0
OTELCOL_VERSION=0.111.0
