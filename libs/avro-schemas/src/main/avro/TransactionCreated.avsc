{
  "type": "record",
  "name": "TransactionCreated",
  "namespace": "com.frauddetect.avro.events",
  "doc": "Emitted by transaction-service after a transaction is persisted (status PENDING). Triggers fraud analysis. v1.",
  "fields": [
    { "name": "eventId", "type": "string", "doc": "Unique id of this event instance (idempotency key for consumers)." },
    { "name": "correlationId", "type": "string", "doc": "End-to-end correlation id propagated from the originating request." },
    { "name": "occurredAt", "type": { "type": "long", "logicalType": "timestamp-millis" }, "doc": "Event production time (UTC)." },
    { "name": "transactionId", "type": "string" },
    { "name": "accountId", "type": "string" },
    { "name": "customerId", "type": "string" },
    { "name": "amount", "type": { "type": "bytes", "logicalType": "decimal", "precision": 19, "scale": 4 }, "doc": "Transaction amount; decimal to avoid float rounding on money." },
    { "name": "currency", "type": "string", "doc": "ISO-4217 currency code." },
    { "name": "type", "type": "string", "doc": "PURCHASE|WITHDRAWAL|TRANSFER|DEPOSIT|PAYMENT|REFUND (string for loose coupling / evolution)." },
    { "name": "merchantId", "type": ["null", "string"], "default": null },
    { "name": "merchantCategory", "type": ["null", "string"], "default": null },
    { "name": "countryCode", "type": "string", "doc": "ISO-3166 alpha-2 country where the transaction originated." },
    { "name": "city", "type": ["null", "string"], "default": null },
    { "name": "latitude", "type": ["null", "double"], "default": null },
    { "name": "longitude", "type": ["null", "double"], "default": null },
    { "name": "deviceId", "type": ["null", "string"], "default": null },
    { "name": "ipAddress", "type": ["null", "string"], "default": null },
    { "name": "channel", "type": "string", "default": "WEB", "doc": "WEB|MOBILE|ATM|POS|API." }
  ]
}
