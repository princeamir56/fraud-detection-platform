{
  "type": "record",
  "name": "TransactionCompleted",
  "namespace": "com.frauddetect.avro.events",
  "doc": "Emitted when a transaction clears fraud analysis and is finalised (status COMPLETED). v1.",
  "fields": [
    { "name": "eventId", "type": "string" },
    { "name": "correlationId", "type": "string" },
    { "name": "occurredAt", "type": { "type": "long", "logicalType": "timestamp-millis" } },
    { "name": "transactionId", "type": "string" },
    { "name": "accountId", "type": "string" },
    { "name": "customerId", "type": "string" },
    { "name": "amount", "type": { "type": "bytes", "logicalType": "decimal", "precision": 19, "scale": 4 } },
    { "name": "currency", "type": "string" },
    { "name": "fraudScore", "type": "int", "doc": "0-100 final fraud score at completion." },
    { "name": "severity", "type": "string", "doc": "LOW|MEDIUM|HIGH|CRITICAL." }
  ]
}
