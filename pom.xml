<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      ==========================================================================
      Fraud Detection Platform — reactor / parent POM
      Single source of truth for versions (Section 0 version policy).
      Parent = spring-boot-starter-parent so every module inherits Boot's
      curated dependency + plugin management.
      ==========================================================================
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>com.frauddetect</groupId>
    <artifactId>fraud-detection-platform</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>fraud-detection-platform</name>
    <description>Real-time financial fraud detection platform (event-driven microservices)</description>

    <modules>
        <module>libs/common</module>
        <module>libs/avro-schemas</module>
        <module>libs/proto-contracts</module>
        <module>services/api-gateway</module>
        <module>services/customer-service</module>
        <module>services/account-service</module>
        <module>services/transaction-service</module>
        <module>services/fraud-detection-service</module>
        <module>services/risk-scoring-service</module>
        <module>services/alert-service</module>
        <module>services/notification-service</module>
        <module>services/audit-service</module>
    </modules>

    <properties>
        <!-- Language / build -->
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.enforcer.requireMavenVersion>[3.9.0,)</maven.enforcer.requireMavenVersion>

        <!-- Platform module versions -->
        <platform.version>1.0.0</platform.version>

        <!-- === Versions NOT managed by the Spring Boot BOM (verify at build time) === -->
        <!-- Latest GA of the 2025.1 (Oakwood) train. NB: this train targets Boot 4.0.x; the platform
             runs Boot 4.1.0 and no Spring Cloud train targets 4.1.x yet, so the api-gateway disables the
             strict compatibility verifier (see its application.yml). Only Gateway Server WebFlux uses it. -->
        <spring-cloud.version>2025.1.3</spring-cloud.version>
        <avro.version>1.12.0</avro.version>
        <protobuf.version>4.29.3</protobuf.version>
        <grpc.version>1.71.0</grpc.version>
        <confluent.version>8.0.0</confluent.version>
        <elasticsearch-java.version>9.0.4</elasticsearch-java.version>
        <!-- Overrides Boot's managed HttpClient 5.6: elasticsearch-java 9.0.4 is built against 5.4.x, and
             5.6's async client transparently gunzips responses, so the ES Rest5Client's own gunzip then
             fails ("Not in GZIP format") on every successful index/search call. Keep aligned with the
             httpclient5 version declared by elasticsearch-java. -->
        <httpclient5.version>5.4.4</httpclient5.version>
        <httpcore5.version>5.3.4</httpcore5.version>
        <resilience4j.version>2.3.0</resilience4j.version>
        <jjwt.version>0.12.5</jjwt.version>
        <springdoc.version>2.8.9</springdoc.version>

        <!-- Plugin versions -->
        <avro-maven-plugin.version>1.12.0</avro-maven-plugin.version>
        <protobuf-maven-plugin.version>0.6.1</protobuf-maven-plugin.version>
        <os-maven-plugin.version>1.7.1</os-maven-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <jacoco-maven-plugin.version>0.8.12</jacoco-maven-plugin.version>

        <!-- protoc / grpc plugin artifacts resolved via os.detected.classifier -->
        <protoc.artifact>com.google.protobuf:protoc:${protobuf.version}:exe:${os.detected.classifier}</protoc.artifact>
        <grpc.plugin.artifact>io.grpc:protoc-gen-grpc-java:${grpc.version}:exe:${os.detected.classifier}</grpc.plugin.artifact>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud BOM (gateway). Version must align with the Boot line. -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- gRPC BOM -->
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Protobuf BOM -->
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-bom</artifactId>
                <version>${protobuf.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Resilience4j BOM -->
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-bom</artifactId>
                <version>${resilience4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Avro -->
            <dependency>
                <groupId>org.apache.avro</groupId>
                <artifactId>avro</artifactId>
                <version>${avro.version}</version>
            </dependency>

            <!-- Confluent Avro serializer (hosted on Confluent repo, not Maven Central) -->
            <dependency>
                <groupId>io.confluent</groupId>
                <artifactId>kafka-avro-serializer</artifactId>
                <version>${confluent.version}</version>
            </dependency>
            <dependency>
                <groupId>io.confluent</groupId>
                <artifactId>kafka-schema-registry-client</artifactId>
                <version>${confluent.version}</version>
            </dependency>

            <!-- Modern Elasticsearch Java API Client (NOT the deprecated HLRC) -->
            <dependency>
                <groupId>co.elastic.clients</groupId>
                <artifactId>elasticsearch-java</artifactId>
                <version>${elasticsearch-java.version}</version>
            </dependency>

            <!-- JWT -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- OpenAPI / Swagger UI -->
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>

            <!-- Internal platform modules -->
            <dependency>
                <groupId>com.frauddetect</groupId>
                <artifactId>common</artifactId>
                <version>${platform.version}</version>
            </dependency>
            <dependency>
                <groupId>com.frauddetect</groupId>
                <artifactId>avro-schemas</artifactId>
                <version>${platform.version}</version>
            </dependency>
            <dependency>
                <groupId>com.frauddetect</groupId>
                <artifactId>proto-contracts</artifactId>
                <version>${platform.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.avro</groupId>
                    <artifactId>avro-maven-plugin</artifactId>
                    <version>${avro-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.xolstice.maven.plugins</groupId>
                    <artifactId>protobuf-maven-plugin</artifactId>
                    <version>${protobuf-maven-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco-maven-plugin.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Enforce the Section 0 version policy mechanically. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-version-policy</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                    <message>Java 21+ is required (version policy Section 0).</message>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>${maven.enforcer.requireMavenVersion}</version>
                                </requireMavenVersion>
                                <!-- Ban SNAPSHOT dependencies (release-only build). -->
                                <requireReleaseDeps>
                                    <message>No SNAPSHOT dependencies allowed (Section 0).</message>
                                    <onlyWhenRelease>true</onlyWhenRelease>
                                </requireReleaseDeps>
                                <!-- Ban SNAPSHOT dependencies (release-only build). -->
                                <requireReleaseDeps>
                                    <message>No SNAPSHOT dependencies allowed (Section 0).</message>
                                    <onlyWhenRelease>true</onlyWhenRelease>
                                </requireReleaseDeps>
                                <!--
                                  Pre-release qualifiers (alpha/beta/rc/milestone) are excluded by
                                  POLICY, not by a bannedDependencies rule: every non-BOM dependency
                                  is pinned to a GA version in the <properties> above, and the rest
                                  are inherited from the Spring Boot BOM (all GA). A version-wildcard
                                  bannedDependencies rule was evaluated and rejected — maven-enforcer's
                                  version matcher treats substring globs such as *:*:*-M* as fail-open,
                                  matching GA versions like 4.1.0 and breaking every build. SNAPSHOTs
                                  are still blocked mechanically by requireReleaseDeps above.
                                -->
                                <banDuplicatePomDependencyVersions/>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
              Unit/slice tests (*Test / *Tests) run on Surefire in the test phase.
              argLine late-binds JaCoCo's prepare-agent value via @{argLine} (so coverage
              still instruments), then adds two JDK 21+ flags that harden Mockito's inline
              (ByteBuddy) mock maker:
                • -Djdk.attach.allowAttachSelf=true — attach the mock-maker agent IN-PROCESS
                  instead of forking a fragile *external* attacher JVM. That external fork is
                  what fails under disk/resource pressure (it must write a helper jar) and is
                  discouraged on modern JDKs.
                • -XX:+EnableDynamicAgentLoading — opt in cleanly so there is no
                  "A Java agent has been loaded dynamically" warning on JDK 21+.
              Version is inherited from the Spring Boot parent's plugin management.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -Djdk.attach.allowAttachSelf=true -XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
            </plugin>

            <!--
              Integration tests: classes named *IT / IT* / *ITCase run under
              Failsafe in the integration-test/verify phases (Section 17). These
              are the Testcontainers tests and require a running Docker daemon.
              The argLine mirrors Surefire's: @{argLine} keeps JaCoCo coverage of the
              IT phase, and the same two flags keep any Mockito use in ITs robust.
              Version is inherited from the Spring Boot parent's plugin management.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <argLine>@{argLine} -Djdk.attach.allowAttachSelf=true -XX:+EnableDynamicAgentLoading</argLine>
                </configuration>
                <executions>
                    <execution>
                        <id>integration-tests</id>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!--
              JaCoCo coverage. prepare-agent (initialize phase) sets the argLine
              honoured by both Surefire and Failsafe, so unit + integration runs
              append to a single exec file; report aggregates them at verify.
              Version is pinned in pluginManagement above (0.8.12).
            -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <!-- Confluent hosts kafka-avro-serializer / schema-registry-client outside Maven Central. -->
    <repositories>
        <repository>
            <id>confluent</id>
            <name>Confluent</name>
            <url>https://packages.confluent.io/maven/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>confluent</id>
            <url>https://packages.confluent.io/maven/</url>
            <releases><enabled>true</enabled></releases>
            <snapshots><enabled>false</enabled></snapshots>
        </pluginRepository>
    </pluginRepositories>
</project>
